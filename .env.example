# Client configuration: every VITE_* value is visible in the browser.
# Use only the Supabase anon/publishable key, never a service_role/secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Configure your own authenticated automation endpoints.
VITE_N8N_DOCUMENT_UPLOAD_WEBHOOK_URL=https://automation.example.com/webhook/document-upload
VITE_N8N_CUSTOMER_SERVICE_UPLOAD_WEBHOOK_URL=https://automation.example.com/webhook/customer-service-upload
VITE_N8N_OPEN_RECEIVED_FILE_WEBHOOK_URL=https://automation.example.com/webhook/open-received-file
VITE_N8N_MANUAL_WHATSAPP_MESSAGE_WEBHOOK_URL=https://automation.example.com/webhook/manual-whatsapp-message
VITE_N8N_INTERNAL_CHAT_WEBHOOK_URL=https://automation.example.com/webhook/internal-chat
VITE_N8N_CONFIGURE_WHATSAPP_CHANNEL_WEBHOOK_URL=https://automation.example.com/webhook/configure-whatsapp-channel
VITE_N8N_TEST_WHATSAPP_CONNECTION_WEBHOOK_URL=https://automation.example.com/webhook/test-whatsapp-connection
VITE_N8N_DELETE_RECEIVED_FILE_WEBHOOK_URL=https://automation.example.com/webhook/delete-received-file
VITE_N8N_DELETE_KNOWLEDGE_DOCUMENT_WEBHOOK_URL=https://automation.example.com/webhook/delete-knowledge-document
VITE_N8N_DISCONNECT_WHATSAPP_CHANNEL_WEBHOOK_URL=https://automation.example.com/webhook/disconnect-whatsapp-channel
VITE_N8N_DELETE_ACCOUNT_WEBHOOK_URL=https://automation.example.com/webhook/delete-account
VITE_N8N_DISCOVERY_FEATURE_WEBHOOK_URL=https://automation.example.com/webhook/discovery-feature
VITE_N8N_CONFIGURE_GMAIL_WEBHOOK_URL=https://automation.example.com/webhook/configure-gmail
VITE_N8N_SEND_GMAIL_EMAIL_WEBHOOK_URL=https://automation.example.com/webhook/send-gmail-email
VITE_N8N_GET_INBOX_MESSAGE_WEBHOOK_URL=https://automation.example.com/webhook/get-inbox-message
VITE_N8N_OPEN_GMAIL_ATTACHMENT_WEBHOOK_URL=https://automation.example.com/webhook/open-gmail-attachment

# Public Google OAuth client settings. Client secrets belong on the server.
VITE_GMAIL_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GMAIL_OAUTH_REDIRECT_URI=https://automation.example.com/webhook/gmail-callback
VITE_GMAIL_OAUTH_SCOPE=https://mail.google.com/

# Public installation identity, used in legal pages and support links.
VITE_PUBLIC_WEBSITE_URL=https://example.com
VITE_SUPPORT_EMAIL=suporte@example.com
VITE_OPERATOR_NAME=Responsável pela instalação
# Frontend demonstration. No backend or real credentials are needed.
VITE_DEMO_MODE=true

