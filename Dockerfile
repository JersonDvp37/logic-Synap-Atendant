FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_DEMO_MODE
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_N8N_DOCUMENT_UPLOAD_WEBHOOK_URL
ARG VITE_N8N_CUSTOMER_SERVICE_UPLOAD_WEBHOOK_URL
ARG VITE_N8N_OPEN_RECEIVED_FILE_WEBHOOK_URL
ARG VITE_N8N_MANUAL_WHATSAPP_MESSAGE_WEBHOOK_URL
ARG VITE_N8N_CONFIGURE_WHATSAPP_CHANNEL_WEBHOOK_URL
ARG VITE_N8N_TEST_WHATSAPP_CONNECTION_WEBHOOK_URL
ARG VITE_N8N_DELETE_RECEIVED_FILE_WEBHOOK_URL
ARG VITE_N8N_DELETE_KNOWLEDGE_DOCUMENT_WEBHOOK_URL
ARG VITE_N8N_DISCONNECT_WHATSAPP_CHANNEL_WEBHOOK_URL
ARG VITE_N8N_DELETE_ACCOUNT_WEBHOOK_URL
ARG VITE_N8N_DISCOVERY_FEATURE_WEBHOOK_URL
ARG VITE_N8N_INTERNAL_CHAT_WEBHOOK_URL
ARG VITE_N8N_CONFIGURE_GMAIL_WEBHOOK_URL
ARG VITE_N8N_SEND_GMAIL_EMAIL_WEBHOOK_URL
ARG VITE_N8N_OPEN_GMAIL_ATTACHMENT_WEBHOOK_URL
ARG VITE_GMAIL_GOOGLE_CLIENT_ID
ARG VITE_GMAIL_OAUTH_REDIRECT_URI
ARG VITE_N8N_GET_INBOX_MESSAGE_WEBHOOK_URL
ARG VITE_GMAIL_OAUTH_SCOPE
ARG VITE_PUBLIC_WEBSITE_URL
ARG VITE_SUPPORT_EMAIL
ARG VITE_OPERATOR_NAME

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_N8N_DOCUMENT_UPLOAD_WEBHOOK_URL=$VITE_N8N_DOCUMENT_UPLOAD_WEBHOOK_URL
ENV VITE_N8N_CUSTOMER_SERVICE_UPLOAD_WEBHOOK_URL=$VITE_N8N_CUSTOMER_SERVICE_UPLOAD_WEBHOOK_URL
ENV VITE_N8N_OPEN_RECEIVED_FILE_WEBHOOK_URL=$VITE_N8N_OPEN_RECEIVED_FILE_WEBHOOK_URL
ENV VITE_N8N_MANUAL_WHATSAPP_MESSAGE_WEBHOOK_URL=$VITE_N8N_MANUAL_WHATSAPP_MESSAGE_WEBHOOK_URL
ENV VITE_N8N_CONFIGURE_WHATSAPP_CHANNEL_WEBHOOK_URL=$VITE_N8N_CONFIGURE_WHATSAPP_CHANNEL_WEBHOOK_URL
ENV VITE_N8N_TEST_WHATSAPP_CONNECTION_WEBHOOK_URL=$VITE_N8N_TEST_WHATSAPP_CONNECTION_WEBHOOK_URL
ENV VITE_N8N_DELETE_RECEIVED_FILE_WEBHOOK_URL=$VITE_N8N_DELETE_RECEIVED_FILE_WEBHOOK_URL
ENV VITE_N8N_DELETE_KNOWLEDGE_DOCUMENT_WEBHOOK_URL=$VITE_N8N_DELETE_KNOWLEDGE_DOCUMENT_WEBHOOK_URL
ENV VITE_N8N_DISCONNECT_WHATSAPP_CHANNEL_WEBHOOK_URL=$VITE_N8N_DISCONNECT_WHATSAPP_CHANNEL_WEBHOOK_URL
ENV VITE_N8N_DELETE_ACCOUNT_WEBHOOK_URL=$VITE_N8N_DELETE_ACCOUNT_WEBHOOK_URL
ENV VITE_N8N_DISCOVERY_FEATURE_WEBHOOK_URL=$VITE_N8N_DISCOVERY_FEATURE_WEBHOOK_URL
ENV VITE_N8N_INTERNAL_CHAT_WEBHOOK_URL=$VITE_N8N_INTERNAL_CHAT_WEBHOOK_URL
ENV VITE_N8N_CONFIGURE_GMAIL_WEBHOOK_URL=$VITE_N8N_CONFIGURE_GMAIL_WEBHOOK_URL
ENV VITE_N8N_SEND_GMAIL_EMAIL_WEBHOOK_URL=$VITE_N8N_SEND_GMAIL_EMAIL_WEBHOOK_URL
ENV VITE_N8N_OPEN_GMAIL_ATTACHMENT_WEBHOOK_URL=$VITE_N8N_OPEN_GMAIL_ATTACHMENT_WEBHOOK_URL
ENV VITE_GMAIL_GOOGLE_CLIENT_ID=$VITE_GMAIL_GOOGLE_CLIENT_ID
ENV VITE_GMAIL_OAUTH_REDIRECT_URI=$VITE_GMAIL_OAUTH_REDIRECT_URI
ENV VITE_GMAIL_OAUTH_SCOPE=$VITE_GMAIL_OAUTH_SCOPE
ENV VITE_N8N_GET_INBOX_MESSAGE_WEBHOOK_URL=$VITE_N8N_GET_INBOX_MESSAGE_WEBHOOK_URL
ENV VITE_PUBLIC_WEBSITE_URL=$VITE_PUBLIC_WEBSITE_URL
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV VITE_OPERATOR_NAME=$VITE_OPERATOR_NAME

RUN if [ "$VITE_DEMO_MODE" = "false" ]; then \
      test -n "$VITE_SUPABASE_URL" && test -n "$VITE_SUPABASE_ANON_KEY"; \
    fi

RUN npm run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
