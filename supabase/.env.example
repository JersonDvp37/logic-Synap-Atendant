# Server-only settings for the document-acess Edge Function.
# SUPABASE_URL and SUPABASE_ANON_KEY are provided by the Supabase runtime.
# Store the values below in your deployment's secrets, never in VITE_* variables.
ALLOWED_ORIGINS=https://example.com
GCS_BUCKET=your-private-bucket
GCP_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GCP_PRIVATE_KEY=
